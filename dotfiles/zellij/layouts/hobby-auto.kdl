// The unattended variant of hobby-dev: same two panes, but the Claude pane runs
// `hauto`, which starts whichever /task:auto stage the task's phase calls for —
// a headless plan process first, then a fresh interactive build process — so the
// plan's context is gone before the build starts.
//
// Helix stays: the play gate at the end of /task:auto is where a person arrives,
// and an editor beside the conversation is what they arrive to.
layout {
    pane split_direction="vertical" {
        pane size="65%" name="editor"
        pane size="35%" command="hauto" name="claude" close_on_exit=false
    }
}
