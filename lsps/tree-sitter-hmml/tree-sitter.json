{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "hmml",
      "camelcase": "Mml",
      "scope": "source.hmml",
      "path": ".",
      "file-types": ["hmml"],
      "highlights": ["queries/highlights.scm"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "MML (Mental Model Language) grammar for tree-sitter",
    "authors": [{ "name": "Julian Bieber" }],
    "links": {
      "repository": "https://github.com/omniaretail/team-constellation-tooling"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
