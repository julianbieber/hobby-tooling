          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "section_header"
        },
        {
          "type": "SYMBOL",
          "name": "io_declaration"
        },
        {
          "type": "SYMBOL",
          "name": "use_import"
        },
        {
          "type": "SYMBOL",
          "name": "type_definition"
        },
        {
