          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "##+"
            }
          },
          "named": true,
          "value": "marker"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "section_name"
          }
        }
      ]
    },
    "section_name": {
      "type": "CHOICE",
