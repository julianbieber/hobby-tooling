                "value": 2,
                "content": {
                  "type": "PATTERN",
                  "value": "[A-Za-z][A-Za-z0-9._-]*(\\/[A-Za-z][A-Za-z0-9._-]*)?"
                }
              }
            },
            "named": true,
            "value": "spec_ref"
          }
        }
