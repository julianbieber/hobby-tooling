#!/usr/bin/env bash
# Reject a commit message carrying machine attribution, or a commit authored
# under the work identity.
#
# A CLAUDE.md rule only reaches the model, and the trailer is injected by the
# harness system prompt — or typed by hand.
#
# Args: $1 = path to the file holding the prospective commit message.

set -uo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./policy-lib.sh
. "$HERE/policy-lib.sh"

MSG_FILE="$1"

run_local_hook() {
    local git_dir local_hook
    git_dir=$(git rev-parse --git-dir 2>/dev/null) || return 0
    local_hook="$git_dir/hooks/commit-msg"
    [ -x "$local_hook" ] || return 0
    "$local_hook" "$@" || exit $?
}
run_local_hook "$@"

policy_in_scope || exit 0

BODY=$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d')
if [ -z "$BODY" ]; then
    policy_die "Empty commit message." \
        "Write the message yourself."
fi

if HITS=$(policy_find_attribution "$MSG_FILE"); then
    policy_die "Machine attribution in the commit message." \
        "$HITS" \
        "" \
        "Refused patterns:" \
        "" \
        "$POLICY_ATTRIBUTION_DESC" \
        "" \
        "Bevy AI policy norm 1 bans the co-author trailer; their CI rejects it." \
        "Disclosure goes in the PR description in your own words (norm 2)."
fi

EMAIL=$(git config user.email 2>/dev/null || true)
if [ "$EMAIL" != "$POLICY_GIT_EMAIL" ]; then
    policy_die "This repo commits as '${EMAIL:-<unset>}', not $POLICY_GIT_EMAIL." \
        "Fix, in this repo:" \
        "  git config user.name  julianbieber" \
        "  git config user.email $POLICY_GIT_EMAIL"
fi

exit 0
