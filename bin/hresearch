#!/usr/bin/env python3
"""Turn a fetched-source question into a fixed-shape research file, and check
one against the sources it cites — the tool `/research` calls so a file's
slots, snippets and quotes are verified by code rather than trusted from the
session that wrote them — and search every project's research files through a
derived index, with no model in the query path.
"""

import argparse
import datetime
import html.parser
import json
import os
import re
import sqlite3
import sys
import textwrap
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

NOTES_BASE = Path.home() / "fun_repos" / "hobby-mimisbrunnr" / "notes"
WORKTREE_BASE = Path.home() / "fun_worktrees"

STOPWORDS = {
    "how", "do", "i", "to", "the", "a", "an", "with", "in", "of", "for", "is", "what",
    "which", "techniques", "technique", "exist", "exists", "approaches", "ways",
    "are", "there", "does", "work", "works",
}

REQUIRED_SLOTS = ("verdict", "how", "snippet", "breaks")

SHAPES = ("card", "matrix", "figure")

_MATRIX_SURVEY_RE = re.compile(
    r"\b(which|what)\b.*\b(techniques?|approaches|options|methods|algorithms|alternatives|ways)\b"
)
_MATRIX_PHRASE_RE = re.compile(r"\b(ways to|alternatives to|approaches to)\b")
_CARD_HOW_DO_RE = re.compile(r"\bhow (do|can|should|would) (i|you|we)\b")
_CARD_HOW_TO_RE = re.compile(r"\bhow to\b")
_FIGURE_START_VERB_RE = re.compile(r"^how (does|do|is|are)\b")
_FIGURE_START_ARTICLE_RE = re.compile(r"^how (a|an|the)\b")
_FIGURE_EXPLAIN_RE = re.compile(r"^explain how\b")
_FIGURE_WORKS_RE = re.compile(r"\bhow .*\bworks?\b")


def classify_shape(question: str) -> str:
    q = WS_RE.sub(" ", question.strip().lower())
    if _MATRIX_SURVEY_RE.search(q) or _MATRIX_PHRASE_RE.search(q):
        return "matrix"
    if _CARD_HOW_DO_RE.search(q) or _CARD_HOW_TO_RE.search(q):
        return "card"
    if (
        _FIGURE_START_VERB_RE.search(q)
        or _FIGURE_START_ARTICLE_RE.search(q)
        or _FIGURE_EXPLAIN_RE.search(q)
        or _FIGURE_WORKS_RE.search(q)
    ):
        return "figure"
    return "card"

MATRIX_CRITERIA = ("looks like", "cost per frame", "jam-sized", "bevy precedent")
PRECEDENT_CRITERION = "bevy precedent"
MATRIX_MAX_OPTIONS = 5
MATRIX_MIN_OPTIONS = 2
CELL_MAX_WORDS = 4
CELL_MAX_CHARS = 32

CARD_EXT = ".hresearch"

LABEL_WIDTH = 9
DEFAULT_WIDTH = 78

FIGURE_MIN_LINES = 3
FIGURE_MAX_LINES = 30
FIGURE_MAX_COLS = DEFAULT_WIDTH
FIGURE_SEGMENT_MAX_WORDS = 5
CAPTION_MAX_WORDS = 16
CAPTION_MAX_CHARS = 120
DRAWING_ASCII = set("|+/\\<>^=#")
DRAWING_UNICODE_RANGES = (
    (0x2500, 0x257F),
    (0x2190, 0x21FF),
    (0x2580, 0x259F),
    (0x25A0, 0x25FF),
)
GITHUB_BLOB_RE = re.compile(r"^https://github\.com/([^/]+)/([^/]+)/blob/([^/]+)/([^#]+)")
BLOCK_TAGS = {
    "p", "div", "li", "br", "tr", "h1", "h2", "h3", "h4", "h5", "h6",
    "pre", "section", "article", "dt", "dd", "table",
}
WS_RE = re.compile(r"\s+")


def resolve_notes_dir(cwd: Path):
    for base in (WORKTREE_BASE, NOTES_BASE):
        try:
            rel = cwd.relative_to(base)
        except ValueError:
            continue
        parts = rel.parts
        if len(parts) < 3:
            continue
        candidate = NOTES_BASE.joinpath(*parts[:3])
        if candidate.is_dir():
            return candidate
    return None


def require_notes_dir() -> Path:
    cwd = Path.cwd()
    notes_dir = resolve_notes_dir(cwd)
    if notes_dir is None:
        print(f"hresearch: not in a hobby task (no notes dir for {cwd})", file=sys.stderr)
        sys.exit(2)
    return notes_dir


def make_slug(question: str) -> str:
    words = [w for w in re.findall(r"[a-z0-9]+", question.lower()) if w not in STOPWORDS]
    return "-".join(words[:5]) or "question"


def unique_stem(research: Path, sources_root: Path, stem: str) -> str:
    candidate = stem
    n = 1
    while (research / f"{candidate}{CARD_EXT}").exists() or (sources_root / candidate).exists():
        n += 1
        candidate = f"{stem}-{n}"
    return candidate


def cmd_new(question: str, shape_override) -> int:
    notes_dir = require_notes_dir()
    research = notes_dir / "research"
    sources_root = research / "sources"
    date = datetime.date.today().isoformat()
    stem = unique_stem(research, sources_root, f"{date}-{make_slug(question)}")
    dir_ = sources_root / stem
    dir_.mkdir(parents=True, exist_ok=True)
    (dir_ / "question.txt").write_text(question.strip() + "\n")
    if shape_override is not None:
        shape, origin = shape_override, "override"
    else:
        shape, origin = classify_shape(question), "from question"
    (dir_ / "shape.txt").write_text(shape + "\n")
    print(f"shape: {shape} ({origin})", file=sys.stderr)
    print(dir_)
    return 0


def recorded_shape(dir_: Path):
    p = dir_ / "shape.txt"
    if not p.exists():
        return None
    return p.read_text().strip() or None


def require_own_sources_dir(dir_arg: str) -> Path:
    notes_dir = require_notes_dir()
    sources_root = (notes_dir / "research" / "sources").resolve()
    d = Path(dir_arg).resolve()
    if d.parent != sources_root:
        print(
            f"hresearch: {dir_arg} is not a sources dir of this task ({notes_dir})",
            file=sys.stderr,
        )
        sys.exit(2)
    return d


def derive_fetch_url(url: str) -> str:
    m = GITHUB_BLOB_RE.match(url)
    if m:
        owner, repo, ref, path = m.groups()
        return f"https://raw.githubusercontent.com/{owner}/{repo}/{ref}/{path}"
    return url


class _TextExtractor(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts = []
        self._skip = 0

    def handle_starttag(self, tag, attrs):
        if tag in ("script", "style"):
            self._skip += 1
        if tag in BLOCK_TAGS:
            self.parts.append("\n")

    def handle_startendtag(self, tag, attrs):
        if tag in BLOCK_TAGS:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag in ("script", "style") and self._skip > 0:
            self._skip -= 1
        if tag in BLOCK_TAGS:
            self.parts.append("\n")

    def handle_data(self, data):
        if not self._skip:
            self.parts.append(data)


def extract_text(markup: str) -> str:
    p = _TextExtractor()
    p.feed(markup)
    return "".join(p.parts)


def fetch_raw(url: str) -> tuple[str, str]:
    req = urllib.request.Request(derive_fetch_url(url), headers={"User-Agent": "hresearch"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        content_type = resp.headers.get("Content-Type", "") or ""
        body = resp.read()
    return content_type, body.decode("utf-8", errors="replace")


def fetch_text(url: str) -> str:
    content_type, body = fetch_raw(url)
    if "html" in content_type.lower() or body.lstrip().startswith("<"):
        return extract_text(body)
    return body


def load_sources(sources_json: Path) -> list:
    if sources_json.exists():
        return json.loads(sources_json.read_text())
    return []


def save_sources(sources_json: Path, sources: list) -> None:
    sources_json.write_text(json.dumps(sources, indent=2) + "\n")


def now_rfc3339() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_fetch(dir_arg: str, url: str) -> int:
    dir_ = require_own_sources_dir(dir_arg)
    if not dir_.is_dir():
        print(f"hresearch: {dir_arg} does not exist", file=sys.stderr)
        return 2
    sources_json = dir_ / "sources.json"
    sources = load_sources(sources_json)

    for s in sources:
        if s["url"] == url:
            txt_path = dir_ / f"{s['id']}.txt"
            print(f"[{s['id']}] {txt_path} ({count_lines(txt_path)} lines)")
            return 0

    try:
        text = fetch_text(url)
    except (urllib.error.URLError, OSError) as exc:
        print(f"hresearch: fetch failed for {url}: {exc}", file=sys.stderr)
        return 1

    next_id = 1 + max((s["id"] for s in sources), default=0)
    txt_path = dir_ / f"{next_id}.txt"
    txt_path.write_text(text)
    sources.append({"id": next_id, "url": url, "fetched": now_rfc3339()})
    save_sources(sources_json, sources)
    print(f"[{next_id}] {txt_path} ({count_lines(txt_path)} lines)")
    return 0


def count_lines(path: Path) -> int:
    text = path.read_text()
    if not text:
        return 0
    return text.count("\n") + (0 if text.endswith("\n") else 1)


def norm(s: str) -> str:
    return WS_RE.sub(" ", s.replace(" ", " ")).strip()


def is_empty_slot(value) -> bool:
    return isinstance(value, dict) and list(value.keys()) == ["empty"]


def render_link(url: str, a: int, b: int) -> str:
    if "github.com" in url:
        base = url.split("#", 1)[0]
        return f"{base}#L{a}-L{b}"
    return url


def find_line_range(source_text: str, code_lines: list):
    first = next((l for l in code_lines if l.strip()), None)
    if first is None:
        return None
    target = first.strip()
    src_lines = source_text.split("\n")
    for idx, line in enumerate(src_lines):
        if line.strip() == target:
            a = idx + 1
            return (a, a + len(code_lines) - 1)
    return None


def check_items(slot_name, value, sources_by_id, problems):
    if is_empty_slot(value):
        return {"empty": value["empty"]}
    if not isinstance(value, list) or not value:
        problems.append(f"{slot_name}: must be a non-empty list, or {{'empty': reason}}")
        return None
    items = []
    ok = True
    for i, item in enumerate(value):
        text = item.get("text") if isinstance(item, dict) else None
        if not isinstance(text, str) or not text.strip() or "\n" in text:
            problems.append(f"{slot_name}[{i}]: text must be a non-empty single-line string")
            ok = False
            continue
        if len(text) > 160:
            problems.append(f"{slot_name}[{i}]: text exceeds 160 chars")
            ok = False
        src = item.get("src")
        if src is not None and src not in sources_by_id:
            problems.append(f"{slot_name}[{i}]: src {src} not in sources.json")
            ok = False
            src = None
        items.append({"text": text, "src": src})
    return {"items": items} if ok else None


def check_snippet(value, sources_by_id, get_source_text, problems):
    if is_empty_slot(value):
        return {"empty": value["empty"]}
    if not isinstance(value, dict) or "code" not in value:
        problems.append("snippet: must be {code, src}, or {'empty': reason}")
        return None
    code = value["code"]
    src = value.get("src")
    if not isinstance(code, str) or not code.strip():
        problems.append("snippet: code must be a non-empty string")
        return None
    code_lines = code.rstrip("\n").split("\n")
    if len(code_lines) > 25:
        problems.append("snippet: exceeds 25 lines")
    if src is None or src not in sources_by_id:
        problems.append("snippet: src is required and must be in sources.json")
        return None
    try:
        source_text = get_source_text(src)
    except LookupError as exc:
        problems.append(f"snippet: {exc}")
        return None
    if norm(code) not in norm(source_text):
        problems.append(f"snippet: not verbatim in source [{src}]")
        return None
    url = sources_by_id[src]["url"]
    a = b = None
    if "github.com" in url:
        rng = find_line_range(source_text, code_lines)
        if rng is None:
            problems.append(f"snippet: could not locate a line range in source [{src}]")
            return None
        a, b = rng
    return {
        "code_lines": textwrap.dedent("\n".join(code_lines)).split("\n"),
        "src": src,
        "url": url,
        "range": (a, b),
    }


def check_breaks(value, sources_by_id, get_source_text, problems):
    if is_empty_slot(value):
        return {"empty": value["empty"]}
    if not isinstance(value, list) or not value:
        problems.append("breaks: must be a non-empty list, or {'empty': reason}")
        return None
    items = []
    ok = True
    for i, item in enumerate(value):
        quote = item.get("quote") if isinstance(item, dict) else None
        src = item.get("src") if isinstance(item, dict) else None
        if not isinstance(quote, str) or not quote.strip():
            problems.append(f"breaks[{i}]: quote must be a non-empty string")
            ok = False
            continue
        if len(quote) > 300:
            problems.append(f"breaks[{i}]: quote exceeds 300 chars")
            ok = False
        if src is None or src not in sources_by_id:
            problems.append(f"breaks[{i}]: src is required and must be in sources.json")
            ok = False
            continue
        try:
            source_text = get_source_text(src)
        except LookupError as exc:
            problems.append(f"breaks[{i}]: {exc}")
            ok = False
            continue
        if norm(quote) not in norm(source_text):
            problems.append(f"breaks[{i}]: not verbatim in source [{src}]")
            ok = False
            continue
        items.append({"quote": quote, "src": src, "url": sources_by_id[src]["url"]})
    return {"items": items} if ok else None


def evaluate(card: dict, sources_by_id: dict, get_source_text) -> tuple:
    problems = []
    for slot in REQUIRED_SLOTS:
        if slot not in card:
            problems.append(f"{slot}: missing")
    if problems:
        return problems, None

    model = {
        "verdict": check_items("verdict", card["verdict"], sources_by_id, problems),
        "how": check_items("how", card["how"], sources_by_id, problems),
        "snippet": check_snippet(card["snippet"], sources_by_id, get_source_text, problems),
        "breaks": check_breaks(card["breaks"], sources_by_id, get_source_text, problems),
    }
    if problems:
        return problems, None
    return [], model


def _row(label: str, text: str, width: int) -> str:
    content = "│ " + f"{label:<{LABEL_WIDTH}}" + text
    return content.ljust(width - 1) + "│"


def cited_ids(model: dict) -> list:
    ids = set()
    for slot in ("verdict", "how"):
        info = model[slot]
        if "items" in info:
            ids.update(i["src"] for i in info["items"] if i["src"] is not None)
    if "src" in model["snippet"]:
        ids.add(model["snippet"]["src"])
    if "items" in model["breaks"]:
        ids.update(i["src"] for i in model["breaks"]["items"])
    return sorted(ids)


def render_card(card: dict, model: dict, sources_by_id: dict, question: str, date: str) -> str:
    fixed_lines = []

    def add_fixed(label, text):
        fixed_lines.append((label, text))

    snippet = model["snippet"]
    if "empty" in snippet:
        add_fixed("snippet", f"empty: {snippet['empty']}")
    else:
        first = True
        for line in snippet["code_lines"]:
            add_fixed("snippet" if first else "", line)
            first = False
        a, b = snippet["range"]
        link = render_link(snippet["url"], a, b) if a is not None else snippet["url"]
        tag = f" [{snippet['src']}]"
        add_fixed("", f"↳ {link}{tag}")

    breaks = model["breaks"]
    if "empty" in breaks:
        add_fixed("breaks", f"empty: {breaks['empty']}")
    else:
        first = True
        for item in breaks["items"]:
            add_fixed("breaks" if first else "", f"\"{item['quote']}\"")
            add_fixed("", f"— {item['url']} [{item['src']}]")
            first = False

    ids = cited_ids(model)
    if ids:
        first = True
        for i in ids:
            add_fixed("source" if first else "", f"[{i}] {sources_by_id[i]['url']}")
            first = False
    else:
        add_fixed("source", "empty: no sources cited")

    top_left = f"┌ {question} "
    top_right = f" {date} ┐"

    longest_fixed = max(
        [len("│ " + f"{lbl:<{LABEL_WIDTH}}" + text) for lbl, text in fixed_lines]
        + [len(top_left) + 1 + len(top_right)]
    )
    width = int(os.environ.get("HRESEARCH_WIDTH", DEFAULT_WIDTH))
    width = max(width, longest_fixed + 4)

    lines = []
    fill = width - len(top_left) - len(top_right)
    if fill < 1:
        fill = 1
    lines.append(top_left + (" " * fill) + top_right)

    text_width = (width - 1) - (2 + LABEL_WIDTH)

    def wrapped_rows(label, entries):
        first = True
        for text in entries:
            wrapped = textwrap.wrap(text, width=max(text_width, 1)) or [""]
            for w in wrapped:
                lines.append(_row(label if first else "", w, width))
                first = False
                label = ""

    for slot, numbered in (("verdict", False), ("how", True)):
        info = model[slot]
        if "empty" in info:
            lines.append(_row(slot, f"empty: {info['empty']}", width))
            continue
        entries = []
        for i, item in enumerate(info["items"]):
            tag = f"[{item['src']}]" if item["src"] is not None else "[unsourced]"
            prefix = f"{i + 1}. " if numbered else ""
            entries.append(f"{prefix}{item['text']} {tag}")
        wrapped_rows(slot, entries)

    for label, text in fixed_lines:
        lines.append(_row(label, text, width))

    lines.append("└" + ("─" * (width - 2)) + "┘")
    return "\n".join(lines) + "\n"


def _validate_precedent_cell(prefix: str, cell, sources_by_id: dict, problems: list):
    if not isinstance(cell, dict):
        problems.append(f"{prefix}: must be an object")
        return None
    if "none" in cell:
        if cell.get("none") is not True or set(cell.keys()) != {"none"}:
            problems.append(f"{prefix}: a 'none' cell must be exactly {{'none': true}}")
            return None
        return {"none": True}
    if set(cell.keys()) - {"src"}:
        problems.append(f"{prefix}: precedent cell takes only src, or 'none': true")
        return None
    src = cell.get("src")
    if not isinstance(src, int) or isinstance(src, bool) or src not in sources_by_id:
        problems.append(f"{prefix}: src is required and must be in sources.json, or 'none': true")
        return None
    return {"src": src}


def _validate_text_cell(prefix: str, cell, sources_by_id: dict, problems: list):
    if not isinstance(cell, dict):
        problems.append(f"{prefix}: must be an object")
        return None
    if set(cell.keys()) - {"text", "src"}:
        problems.append(f"{prefix}: unknown keys")
        return None
    text = cell.get("text")
    if not isinstance(text, str) or not text.strip() or "\n" in text:
        problems.append(f"{prefix}: text must be a non-empty single-line string")
        return None
    if len(text) > CELL_MAX_CHARS:
        problems.append(f"{prefix}: text exceeds {CELL_MAX_CHARS} chars")
        return None
    if len(text.split()) > CELL_MAX_WORDS:
        problems.append(f"{prefix}: text exceeds {CELL_MAX_WORDS} words")
        return None
    src = cell.get("src")
    if src is not None:
        if not isinstance(src, int) or isinstance(src, bool) or src not in sources_by_id:
            problems.append(f"{prefix}: src {src} not in sources.json")
            return None
    return {"text": text, "src": src}


def validate_matrix(card: dict, sources_by_id: dict, problems: list):
    options = card.get("options")
    if not isinstance(options, list) or not (MATRIX_MIN_OPTIONS <= len(options) <= MATRIX_MAX_OPTIONS):
        problems.append(f"options: must be a list of {MATRIX_MIN_OPTIONS}-{MATRIX_MAX_OPTIONS} entries")
        return None

    ok = True
    names = []
    parsed_options = []
    for i, opt in enumerate(options):
        if not isinstance(opt, dict):
            problems.append(f"options[{i}]: must be an object")
            ok = False
            continue
        name = opt.get("name")
        if not isinstance(name, str) or not name.strip() or len(name) > CELL_MAX_CHARS or "\n" in name:
            problems.append(f"options[{i}].name: must be a non-empty single-line string of at most {CELL_MAX_CHARS} chars")
            ok = False
            name = None
        cells = opt.get("cells")
        if not isinstance(cells, dict):
            problems.append(f"options[{i}].cells: must be an object")
            ok = False
            cells = {}
        extra = set(cells) - set(MATRIX_CRITERIA)
        missing = set(MATRIX_CRITERIA) - set(cells)
        if extra:
            problems.append(f"options[{i}].cells: unknown criteria {sorted(extra)}")
            ok = False
        if missing:
            problems.append(f"options[{i}].cells: missing criteria {sorted(missing)}")
            ok = False
        parsed_cells = {}
        for crit in MATRIX_CRITERIA:
            if crit not in cells:
                continue
            prefix = f"options[{i}].cells.{crit}"
            if crit == PRECEDENT_CRITERION:
                parsed = _validate_precedent_cell(prefix, cells[crit], sources_by_id, problems)
            else:
                parsed = _validate_text_cell(prefix, cells[crit], sources_by_id, problems)
            if parsed is None:
                ok = False
            else:
                parsed_cells[crit] = parsed
        if name is not None:
            names.append(name)
        parsed_options.append({"name": name, "cells": parsed_cells})

    if len(set(names)) != len(names):
        problems.append("options: names must be unique")
        ok = False

    verdict = card.get("verdict")
    parsed_verdict = None
    if not isinstance(verdict, dict):
        problems.append("verdict: must be an object with option and text")
        ok = False
    else:
        v_option = verdict.get("option")
        v_text = verdict.get("text")
        if v_option not in names:
            problems.append("verdict.option: must name exactly one option")
            ok = False
        if not isinstance(v_text, str) or not v_text.strip() or "\n" in v_text:
            problems.append("verdict.text: must be a non-empty single-line string")
            ok = False
        elif len(v_text.split()) > CELL_MAX_WORDS:
            problems.append(f"verdict.text: exceeds {CELL_MAX_WORDS} words")
            ok = False
        else:
            parsed_verdict = {"option": v_option, "text": v_text}

    if not ok:
        return None
    return {"options": parsed_options, "verdict": parsed_verdict}


def _matrix_cell_text(crit: str, opt: dict) -> str:
    cell = opt["cells"][crit]
    if crit == PRECEDENT_CRITERION:
        if cell.get("none"):
            return "none found"
        return f"[{cell['src']}]"
    text = cell["text"]
    src = cell.get("src")
    return f"{text} [{src}]" if src is not None else text


def render_matrix(model: dict, sources_by_id: dict, question: str) -> str:
    options = model["options"]
    verdict = model["verdict"]
    col_names = [opt["name"] for opt in options]
    row_labels = list(MATRIX_CRITERIA) + ["verdict"]
    label_width = max(len(l) for l in row_labels)

    rows = [(crit, [_matrix_cell_text(crit, opt) for opt in options]) for crit in MATRIX_CRITERIA]
    verdict_cells = [verdict["text"] if opt["name"] == verdict["option"] else "" for opt in options]
    rows.append(("verdict", verdict_cells))

    col_widths = []
    for idx, name in enumerate(col_names):
        w = len(name)
        for _, cells in rows:
            w = max(w, len(cells[idx]))
        col_widths.append(w)

    def fmt_row(label: str, cells: list) -> str:
        parts = [f"{label:<{label_width}}"]
        parts += [f"{c:<{w}}" for c, w in zip(cells, col_widths)]
        return " | ".join(parts) + " |"

    lines = [f"question: {question}", "", fmt_row("", col_names)]
    for label, cells in rows:
        lines.append(fmt_row(label, cells))
    lines.append("")

    ids = set()
    for opt in options:
        for crit in MATRIX_CRITERIA:
            src = opt["cells"][crit].get("src")
            if src is not None:
                ids.add(src)
    for i in sorted(ids):
        lines.append(f"[{i}] {sources_by_id[i]['url']}")

    return "\n".join(lines) + "\n"


def _is_drawing_char(ch: str) -> bool:
    if ch in DRAWING_ASCII:
        return True
    cp = ord(ch)
    return any(lo <= cp <= hi for lo, hi in DRAWING_UNICODE_RANGES)


def _split_figure_segments(line: str) -> list:
    segments = []
    current = []
    i = 0
    n = len(line)
    while i < n:
        ch = line[i]
        if ch == " " and i + 1 < n and line[i + 1] == " ":
            j = i
            while j < n and line[j] == " ":
                j += 1
            segments.append("".join(current))
            current = []
            i = j
            continue
        if _is_drawing_char(ch):
            segments.append("".join(current))
            current = []
            i += 1
            continue
        current.append(ch)
        i += 1
    segments.append("".join(current))
    return segments


def validate_figure(card: dict, sources_by_id: dict, problems: list):
    raw = card.get("figure")
    if isinstance(raw, list):
        if not all(isinstance(l, str) for l in raw):
            problems.append("figure: list entries must be strings")
            return None
        lines = [l.rstrip() for l in raw]
    elif isinstance(raw, str):
        lines = [l.rstrip() for l in raw.split("\n")]
    else:
        problems.append("figure: must be a string or a list of strings")
        return None

    while lines and lines[0] == "":
        lines.pop(0)
    while lines and lines[-1] == "":
        lines.pop()

    ok = True
    if not (FIGURE_MIN_LINES <= len(lines) <= FIGURE_MAX_LINES):
        problems.append(f"figure: must have {FIGURE_MIN_LINES}-{FIGURE_MAX_LINES} lines, has {len(lines)}")
        ok = False

    for i, line in enumerate(lines, start=1):
        if "\t" in line:
            problems.append(f"figure: line {i}: contains a tab")
            ok = False
        if len(line) > FIGURE_MAX_COLS:
            problems.append(f"figure: line {i}: wider than {FIGURE_MAX_COLS} columns")
            ok = False
        for segment in _split_figure_segments(line):
            words = segment.split()
            if len(words) > FIGURE_SEGMENT_MAX_WORDS:
                problems.append(
                    f"figure: line {i}: {len(words)}-word run is prose, "
                    f"label at most {FIGURE_SEGMENT_MAX_WORDS}"
                )
                ok = False

    if not any(_is_drawing_char(ch) for line in lines for ch in line):
        problems.append("figure: no drawing character found — a figure of words only is prose")
        ok = False

    caption = card.get("caption")
    parsed_caption = None
    if not isinstance(caption, dict) or set(caption.keys()) != {"text", "src"}:
        problems.append("caption: must be exactly {text, src}")
        ok = False
    else:
        text = caption.get("text")
        src = caption.get("src")
        text_ok = True
        if not isinstance(text, str) or not text.strip() or "\n" in text:
            problems.append("caption: text must be a non-empty single-line string")
            text_ok = False
        elif len(text) > CAPTION_MAX_CHARS:
            problems.append(f"caption: text exceeds {CAPTION_MAX_CHARS} chars")
            text_ok = False
        elif len(text.split()) > CAPTION_MAX_WORDS:
            problems.append(f"caption: text exceeds {CAPTION_MAX_WORDS} words")
            text_ok = False
        src_ok = True
        if not isinstance(src, int) or isinstance(src, bool) or src not in sources_by_id:
            problems.append("caption: src is required and must be in sources.json")
            src_ok = False
        if text_ok and src_ok:
            parsed_caption = {"text": text, "src": src}
        else:
            ok = False

    if not ok:
        return None
    return {"lines": lines, "caption": parsed_caption}


def render_figure(model: dict, sources_by_id: dict, question: str) -> str:
    lines = model["lines"]
    caption = model["caption"]
    src = caption["src"]
    body = [f"question: {question}", ""]
    for line in lines:
        body.append(f"    {line}" if line else "")
    body.append(f"    {caption['text']} [{src}]")
    body.append("")
    body.append(f"[{src}] {sources_by_id[src]['url']}")
    return "\n".join(body) + "\n"


def cmd_render(dir_arg: str, source_arg) -> int:
    dir_ = require_own_sources_dir(dir_arg)
    stem = dir_.name
    research = dir_.parent.parent
    card_json_path = dir_ / "card.json"

    if source_arg == "-":
        raw = sys.stdin.read()
    else:
        raw = card_json_path.read_text()
    try:
        card = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"render: card: invalid JSON: {exc}", file=sys.stderr)
        return 1

    shape = card.get("shape", "card")
    if shape not in ("card", "matrix", "figure"):
        print("render: shape: unknown", file=sys.stderr)
        return 1

    recorded = recorded_shape(dir_)
    if recorded is not None and recorded != shape:
        print(
            f"render: shape: the question called for {recorded}, got {shape}",
            file=sys.stderr,
        )
        return 1

    card_json_path.write_text(json.dumps(card, indent=2) + "\n")

    sources = load_sources(dir_ / "sources.json")
    sources_by_id = {s["id"]: s for s in sources}
    question = (dir_ / "question.txt").read_text().strip()

    if shape == "matrix":
        problems = []
        model = validate_matrix(card, sources_by_id, problems)
        if problems:
            for p in problems:
                print(f"render: {p}", file=sys.stderr)
            return 1
        text = render_matrix(model, sources_by_id, question)
    elif shape == "figure":
        problems = []
        model = validate_figure(card, sources_by_id, problems)
        if problems:
            for p in problems:
                print(f"render: {p}", file=sys.stderr)
            return 1
        text = render_figure(model, sources_by_id, question)
    else:
        def get_source_text(src_id):
            path = dir_ / f"{src_id}.txt"
            if not path.exists():
                raise LookupError(f"source [{src_id}] has no stored text")
            return path.read_text()

        problems, model = evaluate(card, sources_by_id, get_source_text)
        if problems:
            for p in problems:
                print(f"render: {p}", file=sys.stderr)
            return 1

        date = stem[:10]
        text = render_card(card, model, sources_by_id, question, date)

    research.mkdir(parents=True, exist_ok=True)
    card_path = research / f"{stem}{CARD_EXT}"
    card_path.write_text(text)
    print(card_path)
    return 0


def cmd_check_matrix(card_md: Path, dir_: Path, card: dict, sources_by_id: dict,
                      question: str, live: bool, require: list) -> int:
    problems = []
    if require:
        problems.append("--require: not applicable to a matrix")

    model = validate_matrix(card, sources_by_id, problems)

    output = ["shape: matrix"]
    if model is not None:
        output.append(f"criteria: {', '.join(MATRIX_CRITERIA)}")
        output.append(f"options: {len(model['options'])}")
        output.append(f"verdict: {model['verdict']['option']}")

        rendered = render_matrix(model, sources_by_id, question)
        if not card_md.exists() or card_md.read_text() != rendered:
            problems.append(f"card.md differs from its card.json ({card_md})")

        precedent_ids = [
            opt["cells"][PRECEDENT_CRITERION]["src"]
            for opt in model["options"]
            if "src" in opt["cells"][PRECEDENT_CRITERION]
        ]
        for i in precedent_ids:
            output.append(f"precedent: [{i}] {sources_by_id[i]['url']}")

        if live:
            for i in sorted(set(precedent_ids)):
                url = sources_by_id[i]["url"]
                try:
                    fetch_text(url)
                except (urllib.error.URLError, OSError) as exc:
                    problems.append(f"--live fetch failed for [{i}] {url}: {exc}")

    for line in output:
        print(line)

    if problems:
        for p in problems:
            print(f"check: {p}", file=sys.stderr)
        return 1
    return 0


def cmd_check_figure(card_md: Path, dir_: Path, card: dict, sources_by_id: dict,
                      question: str, live: bool, require: list) -> int:
    problems = []
    if require:
        problems.append("--require: not applicable to a figure")

    model = validate_figure(card, sources_by_id, problems)

    output = ["shape: figure"]
    if model is not None:
        lines = model["lines"]
        width = max((len(l) for l in lines), default=0)
        output.append(f"figure: {len(lines)} lines, {width} cols")
        src = model["caption"]["src"]
        output.append(f"caption: [{src}] {sources_by_id[src]['url']}")

        rendered = render_figure(model, sources_by_id, question)
        if not card_md.exists() or card_md.read_text() != rendered:
            problems.append(f"card.md differs from its card.json ({card_md})")

        if live:
            url = sources_by_id[src]["url"]
            try:
                fetch_text(url)
            except (urllib.error.URLError, OSError) as exc:
                problems.append(f"--live fetch failed for [{src}] {url}: {exc}")

    for line in output:
        print(line)

    if problems:
        for p in problems:
            print(f"check: {p}", file=sys.stderr)
        return 1
    return 0


def cmd_check_card(card_md: Path, dir_: Path, card: dict, sources_by_id: dict,
                    question: str, date: str, live: bool, require: list) -> int:
    problems = []
    live_cache = {}

    def get_source_text(src_id):
        if live:
            if src_id not in live_cache:
                url = sources_by_id[src_id]["url"]
                try:
                    live_cache[src_id] = fetch_text(url)
                except (urllib.error.URLError, OSError) as exc:
                    raise LookupError(f"--live fetch failed for [{src_id}] {url}: {exc}")
            return live_cache[src_id]
        path = dir_ / f"{src_id}.txt"
        if not path.exists():
            raise LookupError(f"source [{src_id}] has no stored text")
        return path.read_text()

    problems, model = evaluate(card, sources_by_id, get_source_text)

    output = ["shape: card", "slots: verdict how snippet breaks source"]

    if model is not None:
        rendered = render_card(card, model, sources_by_id, question, date)
        if not card_md.exists() or card_md.read_text() != rendered:
            problems.append(f"card.md differs from its card.json ({card_md})")

        snippet = model["snippet"]
        if "empty" not in snippet:
            a, b = snippet["range"]
            link = render_link(snippet["url"], a, b) if a is not None else snippet["url"]
            output.append(f"snippet: verbatim in {link}")

        breaks = model["breaks"]
        if "empty" not in breaks:
            for item in breaks["items"]:
                output.append(f"breaks: verbatim in {item['url']}")

        sourced = unsourced = 0
        for slot in ("verdict", "how"):
            info = model[slot]
            if "items" in info:
                for item in info["items"]:
                    if item["src"] is not None:
                        sourced += 1
                    else:
                        unsourced += 1
        output.append(f"claims: {sourced} sourced, {unsourced} unsourced")

        for slot in require:
            if slot not in model:
                problems.append(f"--require {slot}: unknown slot")
            elif "empty" in model[slot]:
                problems.append(f"--require {slot}: slot is empty")

    for line in output:
        print(line)

    if problems:
        for p in problems:
            print(f"check: {p}", file=sys.stderr)
        return 1
    return 0


def cmd_check(card_arg: str, live: bool, require: list) -> int:
    card_md = Path(card_arg)
    stem = card_md.stem
    dir_ = card_md.parent / "sources" / stem
    card_json_path = dir_ / "card.json"

    if not card_json_path.exists():
        print(f"check: no card.json for {card_md}", file=sys.stderr)
        return 1

    card = json.loads(card_json_path.read_text())
    sources = load_sources(dir_ / "sources.json")
    sources_by_id = {s["id"]: s for s in sources}
    question = (dir_ / "question.txt").read_text().strip()
    date = stem[:10]

    shape = card.get("shape", "card")
    if shape == "matrix":
        rc = cmd_check_matrix(card_md, dir_, card, sources_by_id, question, live, require)
    elif shape == "figure":
        rc = cmd_check_figure(card_md, dir_, card, sources_by_id, question, live, require)
    else:
        rc = cmd_check_card(card_md, dir_, card, sources_by_id, question, date, live, require)

    recorded = recorded_shape(dir_)
    if recorded is not None and recorded != shape:
        print(f"check: shape {shape} but the question called for {recorded}", file=sys.stderr)
        return 1
    return rc


def cmd_list() -> int:
    notes_dir = require_notes_dir()
    research = notes_dir / "research"
    sources_root = research / "sources"
    if not sources_root.is_dir():
        return 0
    for d in sorted(p for p in sources_root.iterdir() if p.is_dir()):
        stem = d.name
        question_path = d / "question.txt"
        question = question_path.read_text().strip() if question_path.exists() else ""
        card_json_path = d / "card.json"
        if card_json_path.exists():
            try:
                shape = json.loads(card_json_path.read_text()).get("shape", "card")
            except json.JSONDecodeError:
                shape = recorded_shape(d) or "?"
        else:
            shape = recorded_shape(d) or "?"
        card_path = research / f"{stem}{CARD_EXT}"
        file_field = str(card_path.relative_to(notes_dir)) if card_path.exists() else "-"
        print(f"{stem}\t{shape}\t{file_field}\t{question}")
    return 0

INDEX_SCHEMA_VERSION = 1
UNPINNED = "unpinned"
UNPINNED_REFS = {"latest", "*"}
VERSION_RE = re.compile(r"^v?(\d+(?:\.\d+)*(?:[-+][\w.]+)?)$")
DOCS_RS_RE = re.compile(r"^https?://docs\.rs/([^/#?]+)(?:/([^/#?]+))?")
DOCS_ITEM_RE = re.compile(
    r"\b(?:struct|enum|trait|fn|type|macro|derive|constant|attr|union)\.(\w+)\.html"
)
CAMEL_RE = re.compile(r"\b[A-Z][a-z0-9]+[A-Z]\w*\b|\b[A-Z][a-z]+\w*(?=::)")
CARD_FILES = ("question.txt", "card.json", "sources.json")


def index_path() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or str(Path.home() / ".cache")
    path = Path(base) / "hresearch" / "index.sqlite"
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def open_index() -> sqlite3.Connection:
    conn = sqlite3.connect(index_path(), timeout=30)
    if conn.execute("PRAGMA user_version").fetchone()[0] != INDEX_SCHEMA_VERSION:
        with conn:
            conn.execute("DROP TABLE IF EXISTS cards")
            conn.execute("DROP TABLE IF EXISTS crates")
            conn.execute("DROP TABLE IF EXISTS docs")
            conn.execute(
                "CREATE TABLE cards (dir TEXT PRIMARY KEY, mtime REAL, project TEXT,"
                " topic TEXT, task TEXT, stem TEXT, date TEXT, shape TEXT,"
                " question TEXT, path TEXT, primary_crate TEXT, primary_version TEXT)"
            )
            conn.execute("CREATE TABLE crates (dir TEXT, crate TEXT, version TEXT)")
            conn.execute("CREATE INDEX crates_dir ON crates(dir)")
            conn.execute(
                "CREATE VIRTUAL TABLE docs USING fts5(dir UNINDEXED, question, body,"
                " idents, urls, tokenize=\"unicode61 tokenchars '_'\")"
            )
            conn.execute(f"PRAGMA user_version = {INDEX_SCHEMA_VERSION}")
    return conn


def norm_crate(name: str) -> str:
    return name.replace("-", "_").lower()


def norm_version(ref: str) -> str:
    m = VERSION_RE.match(ref)
    return m.group(1) if m else UNPINNED


def crate_of(url: str):
    m = DOCS_RS_RE.match(url)
    if m:
        name, ver = m.groups()
        if name == "crate":
            parts = url.split("docs.rs/crate/", 1)[1].split("/")
            name, ver = parts[0], (parts[1] if len(parts) > 1 else None)
        if not name:
            return None
        if ver is None or ver in UNPINNED_REFS:
            return norm_crate(name), UNPINNED
        return norm_crate(name), norm_version(ver)
    m = GITHUB_BLOB_RE.match(url)
    if m:
        _owner, repo, ref, path = m.groups()
        segments = path.split("/")
        name = segments[1] if len(segments) > 2 and segments[0] == "crates" else repo
        return norm_crate(name), norm_version(ref)
    return None


def primary_crate(pairs: list):
    if not pairs:
        return None, None
    counts = {}
    for name, _ver in pairs:
        counts[name] = counts.get(name, 0) + 1
    best = max(counts.values())
    name = next(n for n, _ in pairs if counts[n] == best)
    pinned = [v for n, v in pairs if n == name and v != UNPINNED]
    if not pinned:
        return name, UNPINNED
    tally = {}
    for v in pinned:
        tally[v] = tally.get(v, 0) + 1
    top = max(tally.values())
    return name, next(v for v in pinned if tally[v] == top)


def card_strings(value, out: list) -> None:
    if isinstance(value, str):
        out.append(value)
    elif isinstance(value, list):
        for v in value:
            card_strings(v, out)
    elif isinstance(value, dict):
        for k, v in value.items():
            if k != "shape":
                card_strings(v, out)


def card_idents(urls: list, text: str) -> str:
    seen = {}
    for url in urls:
        for name in DOCS_ITEM_RE.findall(url):
            seen.setdefault(name, None)
    for name in CAMEL_RE.findall(text):
        seen.setdefault(name, None)
    return " ".join(seen)


def card_dirs():
    for d in NOTES_BASE.glob("*/*/*/research/sources/*"):
        if not d.is_dir():
            continue
        rendered = d.parent.parent / f"{d.name}{CARD_EXT}"
        if rendered.is_file() and (d / "card.json").is_file():
            yield d, rendered


def card_mtime(d: Path, rendered: Path) -> float:
    paths = [d / f for f in CARD_FILES] + [rendered]
    return max(p.stat().st_mtime for p in paths if p.exists())


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return default


def index_card(conn, d: Path, rendered: Path, mtime: float) -> None:
    key = str(d)
    project, topic, task = d.relative_to(NOTES_BASE).parts[:3]
    card = read_json(d / "card.json", {})
    if not isinstance(card, dict):
        card = {}
    sources = read_json(d / "sources.json", [])
    urls = [s["url"] for s in sources if isinstance(s, dict) and isinstance(s.get("url"), str)]
    qpath = d / "question.txt"
    question = qpath.read_text().strip() if qpath.exists() else ""
    strings = []
    card_strings(card, strings)
    body = "\n".join(strings)
    pairs = [c for c in (crate_of(u) for u in urls) if c is not None]
    crate, version = primary_crate(pairs)
    conn.execute("DELETE FROM cards WHERE dir = ?", (key,))
    conn.execute("DELETE FROM crates WHERE dir = ?", (key,))
    conn.execute("DELETE FROM docs WHERE dir = ?", (key,))
    conn.execute(
        "INSERT INTO cards VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
        (key, mtime, project, topic, task, d.name, d.name[:10],
         card.get("shape", "card"), question, str(rendered), crate, version),
    )
    conn.executemany(
        "INSERT INTO crates VALUES (?,?,?)", [(key, n, v) for n, v in sorted(set(pairs))]
    )
    conn.execute(
        "INSERT INTO docs VALUES (?,?,?,?,?)",
        (key, question, body, card_idents(urls, body), " ".join(urls)),
    )


def refresh_index(conn) -> None:
    with conn:
        stored = dict(conn.execute("SELECT dir, mtime FROM cards"))
        seen = set()
        for d, rendered in card_dirs():
            key = str(d)
            seen.add(key)
            mtime = card_mtime(d, rendered)
            if stored.get(key) != mtime:
                index_card(conn, d, rendered, mtime)
        for key in set(stored) - seen:
            for table in ("cards", "crates", "docs"):
                conn.execute(f"DELETE FROM {table} WHERE dir = ?", (key,))


def worktree_root(cwd: Path):
    try:
        rel = cwd.relative_to(WORKTREE_BASE)
    except ValueError:
        return None
    if len(rel.parts) < 3:
        return None
    return WORKTREE_BASE.joinpath(*rel.parts[:3])


def find_lock(cwd: Path):
    root = worktree_root(cwd)
    if root is None:
        return None
    d = cwd
    while True:
        if (d / "Cargo.lock").is_file():
            return d / "Cargo.lock"
        if d == root:
            break
        d = d.parent
    below = list(root.glob("*/Cargo.lock"))
    return below[0] if len(below) == 1 else None


def worktree_lock_versions(cwd: Path):
    lock = find_lock(cwd)
    if lock is None:
        return None
    try:
        data = tomllib.loads(lock.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return None
    versions = {}
    for pkg in data.get("package", []):
        name, ver = pkg.get("name"), pkg.get("version")
        if name and ver:
            versions.setdefault(norm_crate(name), set()).add(ver)
    return versions


def version_tag(crate, version, lock) -> str:
    if lock is None or crate is None:
        return "-"
    if version == UNPINNED:
        return UNPINNED
    if crate not in lock:
        return "-"
    return "current" if version in lock[crate] else "other-version"


def fts_query(terms: list) -> str:
    quoted = []
    for term in terms:
        for word in term.split():
            word = word.replace('"', "")
            if word:
                quoted.append(f'"{word}"*')
    return " AND ".join(quoted)


def cmd_search(terms: list, crate_filter, shape, project) -> int:
    conn = open_index()
    refresh_index(conn)
    where, params = [], []
    query = fts_query(terms)
    if query:
        sql = ("SELECT c.date, c.shape, c.primary_crate, c.primary_version, c.question,"
               " c.path FROM docs JOIN cards c ON c.dir = docs.dir")
        where.append("docs MATCH ?")
        params.append(query)
        order = "bm25(docs), c.date DESC"
    else:
        sql = ("SELECT c.date, c.shape, c.primary_crate, c.primary_version, c.question,"
               " c.path FROM cards c")
        order = "c.date DESC, c.stem DESC"
    if shape:
        where.append("c.shape = ?")
        params.append(shape)
    if project:
        where.append("c.project = ?")
        params.append(project)
    if crate_filter:
        name, _, ver = crate_filter.partition("@")
        if ver:
            where.append("EXISTS (SELECT 1 FROM crates k WHERE k.dir = c.dir"
                         " AND k.crate = ? AND k.version = ?)")
            params += [norm_crate(name), ver]
        else:
            where.append("EXISTS (SELECT 1 FROM crates k WHERE k.dir = c.dir AND k.crate = ?)")
            params.append(norm_crate(name))
    if where:
        sql += " WHERE " + " AND ".join(where)
    rows = conn.execute(f"{sql} ORDER BY {order}", params).fetchall()
    conn.close()
    if not rows:
        return 1
    lock = worktree_lock_versions(Path.cwd())
    for date, shp, crate, version, question, path in rows:
        crate_col = f"{crate}@{version}" if crate else "-"
        tag = version_tag(crate, version, lock)
        print(f"{date} {shp} {crate_col} {tag} {question}  {path}")
    return 0


def main(argv) -> int:
    parser = argparse.ArgumentParser(prog="hresearch")
    sub = parser.add_subparsers(dest="command", required=True)

    p_new = sub.add_parser("new")
    p_new.add_argument("question")
    p_new.add_argument("--shape", choices=SHAPES, default=None)

    sub.add_parser("list")

    p_fetch = sub.add_parser("fetch")
    p_fetch.add_argument("dir")
    p_fetch.add_argument("url")

    p_render = sub.add_parser("render")
    p_render.add_argument("dir")
    p_render.add_argument("source", nargs="?", default=None)

    p_check = sub.add_parser("check")
    p_check.add_argument("card")
    p_check.add_argument("--live", action="store_true")
    p_check.add_argument("--require", action="append", default=[])

    p_search = sub.add_parser("search")
    p_search.add_argument("terms", nargs="*")
    p_search.add_argument("--crate", default=None)
    p_search.add_argument("--shape", choices=SHAPES, default=None)
    p_search.add_argument("--project", default=None)

    args = parser.parse_args(argv)

    if args.command == "new":
        return cmd_new(args.question, args.shape)
    if args.command == "list":
        return cmd_list()
    if args.command == "fetch":
        return cmd_fetch(args.dir, args.url)
    if args.command == "render":
        return cmd_render(args.dir, args.source)
    if args.command == "check":
        return cmd_check(args.card, args.live, args.require)
    if args.command == "search":
        return cmd_search(args.terms, args.crate, args.shape, args.project)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
