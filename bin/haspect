#!/usr/bin/env bash
# The Claude pane of an aspect's tab, the same for every kind: start /task:aspect
# while the aspect is still `open`, resume the aspect's last conversation running
# /task:aspect while it is unfinished, so a respawned tab picks up what changed
# while it was gone, and resume it idle once it is finished.
#
# Runs from the aspect worktree (~/fun_aspects/<project>/<topic>/<task>/<name>)
# and reads aspect.json in notes/<project>/<topic>/<task>/aspects/<name>/.
# Records this pane's own id there as claude-pane.json on every start, as hauto
# does for a task. Exit 1 when the cwd is not an aspect worktree; otherwise it
# becomes the claude process.

set -uo pipefail

ASPECT_BASE="$HOME/fun_aspects"
NOTES_BASE="$HOME/fun_repos/hobby-mimisbrunnr/notes"

case "$PWD" in
  "$ASPECT_BASE"/*/*/*/*) ;;
  *) echo "haspect: $PWD is not an aspect worktree under $ASPECT_BASE" >&2; exit 1 ;;
esac
REL="${PWD#"$ASPECT_BASE"/}"
PROJECT="${REL%%/*}"; REST="${REL#*/}"
TOPIC="${REST%%/*}"; REST="${REST#*/}"
TASK="${REST%%/*}"; REST="${REST#*/}"
NAME="${REST%%/*}"
DIR="$NOTES_BASE/$PROJECT/$TOPIC/$TASK/aspects/$NAME"

if [ -n "${ZELLIJ_PANE_ID:-}" ]; then
  mkdir -p "$DIR"
  jaq -n --arg session "${ZELLIJ_SESSION_NAME:-}" --arg pane_id "terminal_$ZELLIJ_PANE_ID" \
    --arg worktree "$PWD" --arg recorded "$(date -u +%FT%TZ)" \
    '{session: $session, pane_id: $pane_id, worktree: $worktree, recorded: $recorded}' \
    > "$DIR/claude-pane.json" || true
fi

STATE=$(jaq -r '.state // "open"' "$DIR/aspect.json" 2>/dev/null || echo open)
case "$STATE" in
  open) exec chobby "/task:aspect" ;;
  reported | done | closed) exec chobby --continue ;;
  *) exec chobby --continue "/task:aspect" ;;
esac
