# MML spec template (classic kinds) — copied to
# notes/{project}/{topic}/{task}/<unit>.mml and filled in by hand.
#
# Lines starting with # at column 0 are comments and are ignored by the parser.
# ## at column 0 is always a section header, never a comment.
# Indentation is spaces only, 2 spaces per nesting level.
#
# For a Bevy plugin or system, use template-plugin.mml / template-system.mml
# instead — those kinds have no in:/out:.

system: my-system
unit: my-unit
# kind is one of: endpoint | workflow | job
kind: workflow
# method: GET             # endpoints only
# source:                 # optional — fill in once the target is known
#   repo: my_repo
#   paths:
#     - src/lib.rs

## modules
# One line per behavioural collaborator:
#   PascalName — responsibility [@ repo-relative-path] [@ spec <unit>]

## data
# use <sibling-unit>: SharedType     # reuse instead of redeclaring
# struct Thing {
#   id: Uuid,
#   name: String,
# }
# enum Outcome {
#   ok,
#   rejected,
# }
in:  String
out: String

## behavior
# Nested `-` bullets at mental-model altitude; 2 spaces per level.
# Control flow: if …: / else: / for each …: / while …: / try: / on error …:
- describe the first step here

## invariants
# One `-` bullet per property that must always hold.
