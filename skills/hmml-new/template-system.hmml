# HMML spec template — one Bevy system, split out of a plugin. Copied to
# notes/{project}/{topic}/{task}/<unit>.hmml and filled in by hand.
#
# Use this when one system's behavior outgrows a few nested bullets in its
# plugin spec. Point at it from the plugin's system entry:
#
#   my_system — what it does @ spec <this-unit>
#
# `## access`, `## behavior` and `## invariants` are required; `## data` and the
# world sections are optional and usually hold `use` imports rather than
# declarations — the plugin owns the shapes, this file borrows them.

system: my-system
unit: my-unit
kind: system
# source:
#   repo: my_bevy_game
#   paths:
#     - src/my_feature/my_system.rs

## data
# Role-less shapes this system's prose or fields need.
# use <plugin-unit>: SpawnPattern

## components
# use <plugin-unit>: Health, Enemy

## resources
# use <plugin-unit>: MyConfig

## events

## access
# Same keys as a plugin's system entry, unindented. `schedule:` is required;
# omit any key this system does not use.
schedule: Update
# set:      MySet
# after:    some_other_system
# before:   yet_another_system
# run_if:   MyConfig is enabled
# query:    Transform + Enemy - Dead
# reads:    MyConfig, Time
# writes:   Health
# spawns:   Health, Enemy
# despawns: Enemy
# emits:    SomethingHappened
# consumes: SomethingHappened

## behavior
# Nested `-` bullets at mental-model altitude; 2 spaces per level.
- describe the first step here

## invariants
# One `-` bullet per property that must always hold.
