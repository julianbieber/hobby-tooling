# hdash — terminal dashboard of hobby work items (tasks, worktrees, PRs, Claude sessions)

# List all recipes
default:
    @just --list

# Build the dashboard (dev profile)
build:
    cargo build -p hdash_app

# Build the optimized release binary
release:
    cargo build -p hdash_app --release

# Run the dashboard in this terminal (dev build)
run:
    cargo run -p hdash_app

# Run the optimized release build
run-release:
    cargo run -p hdash_app --release

# Install the `hdash` binary to ~/.cargo/bin
install:
    cargo install --path crates/hdash_app

# Uninstall the binary
uninstall:
    cargo uninstall hdash_app

# Type-check the whole workspace
check:
    cargo check --workspace

# Lint with clippy
lint:
    cargo clippy --workspace --all-targets

# Format the code
fmt:
    cargo fmt

# Run the tests
test:
    cargo test --workspace

# Remove build artifacts
clean:
    cargo clean

# Launch the app in an Alacritty window and screenshot it (dev helper; needs xdotool + imagemagick)
shot out="/tmp/hdash-shot.png": release
    ./shot.sh {{out}}
