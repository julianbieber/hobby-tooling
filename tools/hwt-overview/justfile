# hwt-overview — Bevy dashboard of hobby worktree tasks

# List all recipes
default:
    @just --list

# Build the dashboard (dev profile; dependencies are optimized so the app is usable)
build:
    cargo build -p hwt_app

# Build the optimized release binary
release:
    cargo build -p hwt_app --release

# Run the worktree dashboard (dev build)
run:
    cargo run -p hwt_app

# Run the optimized release build of the worktree dashboard
run-release:
    cargo run -p hwt_app --release

# Install the `hwt-overview` binary to ~/.cargo/bin
install:
    cargo install --path crates/hwt_app

# Uninstall the binary
uninstall:
    cargo uninstall hwt_app

# Type-check the whole workspace
check:
    cargo check --workspace

# Lint with clippy
lint:
    cargo clippy --workspace

# Format the code
fmt:
    cargo fmt

# Remove build artifacts
clean:
    cargo clean

# Launch the app and screenshot its window (dev helper)
shot out="/tmp/wt-shot.png": build
    ./shot.sh {{out}}

