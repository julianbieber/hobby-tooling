# hcoord — the coordinator's task-list TUI and pipeline-state wait

# List all recipes
default:
    @just --list

# Build
build:
    cargo build --locked

# Install the `hcoord` binary to ~/.cargo/bin
install:
    cargo install --locked --path .

# Lint with clippy
lint:
    cargo clippy --all-targets --locked -- -D warnings

# Run the tests
test:
    cargo test --locked
