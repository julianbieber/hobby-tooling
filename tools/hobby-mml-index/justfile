# mml-index — generate index.md for a repository of MML specs

# List all recipes
default:
    @just --list

# Build (dev)
build:
    cargo build

# Build the optimized release binary
release:
    cargo build --release

# Regenerate index.md for the given spec root (defaults to ~/projects/mml-specs)
run root="":
    cargo run -- {{root}}

# Install the `mml-index` binary to ~/.cargo/bin
install:
    cargo install --path .

# Uninstall the binary
uninstall:
    cargo uninstall julian-mml-index

# Type-check
check:
    cargo check

# Lint with clippy
lint:
    cargo clippy

# Format the code
fmt:
    cargo fmt

# Remove build artifacts
clean:
    cargo clean
